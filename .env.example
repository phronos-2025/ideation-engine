# ---------------------------------------------------------------------------
# Phronos environment. Copy to .env (never commit .env). Server-side only —
# no secret here is ever shipped to the browser (invariant #8 / NFR-1).
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection string (PgBouncer) — used by the HTTP/serverless driver
# for short-lived API calls. Get it from the Neon dashboard.
DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/phronos?sslmode=require"
# Direct (unpooled) connection — used by migrations and the worker's small pool.
DATABASE_URL_UNPOOLED="postgres://USER:PASSWORD@HOST.REGION.aws.neon.tech/phronos?sslmode=require"

# --- API service (Railway) -------------------------------------------------
# Shared secret the Vercel front end presents to the Railway API. Generate a
# long random value (e.g. `openssl rand -hex 32`). Set on BOTH Vercel and Railway.
API_SERVICE_TOKEN="change-me-long-random"
PORT=8080

# --- Cloudflare Access (auth) ---------------------------------------------
# Used by the API to verify the Cf-Access-Jwt-Assertion header (Phase 0 deploy).
# Team domain looks like: https://<team>.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
# The single allowlisted identity (your email) — defense in depth alongside the
# Cloudflare Access policy.
ALLOWED_IDENTITY="vishal@epochal.health"

# --- Models (Phase 2; not needed for Phase 0) ------------------------------
ANTHROPIC_API_KEY=""
VOYAGE_API_KEY=""

# --- Zotero (Phase 1; not needed for Phase 0) ------------------------------
ZOTERO_API_KEY=""
ZOTERO_LIBRARY_ID=""
ZOTERO_LIBRARY_TYPE="user" # or "group"

# --- Web app ---------------------------------------------------------------
# Base URL the browser/SSR uses to reach the API (Railway public URL in prod).
PUBLIC_API_BASE_URL="http://localhost:8080"
